---
import { CATEGORIES } from '../config';
interface Props {
  id: string;
  titulo: string;
  descripcion: string;
  categoria: keyof typeof CATEGORIES;
}
const { id, titulo, descripcion, categoria } = Astro.props;
---
<a href={`/guias/${id}/`} class="block rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-md">
  <span class="text-xs font-semibold uppercase tracking-wide text-brand-600">{CATEGORIES[categoria]}</span>
  <h3 class="mt-1 text-lg font-bold text-slate-900">{titulo}</h3>
  <p class="mt-1 line-clamp-2 text-sm text-slate-600">{descripcion}</p>
</a>
