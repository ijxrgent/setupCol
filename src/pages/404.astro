---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada">
  <div class="py-20 text-center">
    <h1 class="text-4xl font-extrabold text-slate-900">404</h1>
    <p class="mt-2 text-slate-600">Esta página no existe o fue movida.</p>
    <a href="/" class="mt-6 inline-block font-semibold text-brand-600">Volver al inicio</a>
  </div>
</Base>
