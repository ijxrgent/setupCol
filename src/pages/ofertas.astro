---
import Base from '../layouts/Base.astro';

// Actualiza esta lista cada semana. Más adelante la puedes mover a un JSON o a DynamoDB.
const ofertas: { nombre: string; detalle: string; link: string; tienda: 'Mercado Libre' | 'Temu' }[] = [
  // { nombre: 'Soporte para laptop de aluminio', detalle: '-30% esta semana', link: 'https://...', tienda: 'Mercado Libre' },
];
---
<Base title="Ofertas de la semana" description="Descuentos de la semana en sillas, escritorios, monitores y accesorios para tu setup.">
  <h1 class="text-3xl font-extrabold text-slate-900">Ofertas de la semana</h1>
  <p class="mt-2 text-slate-600">Descuentos revisados a mano. Los precios cambian rápido, verifica antes de comprar.</p>

  {ofertas.length === 0 ? (
    <p class="mt-8 rounded-xl border border-dashed border-slate-300 p-6 text-center text-slate-500">
      Aún no hay ofertas publicadas.
    </p>
  ) : (
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {ofertas.map((o) => (
        <li class="rounded-2xl border border-slate-200 bg-white p-5">
          <span class="text-xs font-semibold text-slate-500">{o.tienda}</span>
          <h2 class="mt-1 font-bold text-slate-900">{o.nombre}</h2>
          <p class="text-sm text-emerald-700">{o.detalle}</p>
          <a href={o.link} target="_blank" rel="sponsored nofollow noopener" class="mt-3 inline-block text-sm font-semibold text-brand-600">Ver oferta →</a>
        </li>
      ))}
    </ul>
  )}
</Base>
